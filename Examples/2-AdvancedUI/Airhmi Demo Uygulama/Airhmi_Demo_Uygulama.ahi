AudioStatusGet(&amp;s);

if( s == 0 )
{
   
    int SoundFile;
    LocalIntVarGet("SoundFile" , &amp;SoundFile);
    SoundFile--;
    if( SoundFile &lt; 1 )
        SoundFile = 1;
    LocalIntVarSet("SoundFile" , SoundFile);
    
    char data[200];
    
    sprintf(data,"Music%d.wav",SoundFile);
    LabelSet("MusicName" , "Text" , data);
    
    ImageSet("prew" , "Visible", "True");
    

}
