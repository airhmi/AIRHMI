<?xml version="1.0" encoding="utf-8"?>
<AirPanelPC>
  <Controls ID="Options">
    <DeviceComPort>
    </DeviceComPort>
    <DeviceBautRate>115200</DeviceBautRate>
    <UploadInterface>ttl</UploadInterface>
    <ofs>Screen1</ofs>
    <StartVideoStorage>Flash</StartVideoStorage>
    <Openlogo>logoSave</Openlogo>
    <AcilisLogosuMS>2000</AcilisLogosuMS>
    <AcilisLogoYon>Horizontal</AcilisLogoYon>
  </Controls>
  <Controls ID="Screen">
    <OnStart>#include "stdio.h"
#include "stdlib.h"
#include "string.h"
#include "stk.h"

char deger[25];
int fa_deger , choose_FA;
double label_value;

GlobalIntVarGet("Genlik" , &amp;fa_deger);


memset(deger , 0x00 , sizeof(deger));
label_value = fa_deger;
sprintf(deger , "%.1f V" , label_value / 2);
LabelSet("ELabel3" , "Caption" , deger);


DrawScreen();


</OnStart>
    <Functions>
    </Functions>
    <BgColor>-16777216</BgColor>
    <Name>Screen5</Name>
    <Rotate>Horizontal</Rotate>
