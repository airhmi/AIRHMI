if( Sin_Ucgen == 1 )
{
    ImageSet("EImage12" , "Visible" , "1");
    ImageSet("EImage14" , "Visible" , "1");

    ImageSet("EImage13" , "Visible" , "0");
    ImageSet("EImage15" , "Visible" , "0");
    
    printf("&lt;ROLE&gt;&lt;R5&gt;0&lt;/R5&gt;&lt;/ROLE&gt;\n");
}
else
{
