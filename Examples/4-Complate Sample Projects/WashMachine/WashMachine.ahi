  <Controls ID="EVariable">
    <name>VPKapakDurumu</name>
    <Left>115</Left>
    <Top>0</Top>
    <Data>0</Data>
    <Type>int</Type>
    <Locked>False</Locked>
    <Modifiers>Private</Modifiers>
