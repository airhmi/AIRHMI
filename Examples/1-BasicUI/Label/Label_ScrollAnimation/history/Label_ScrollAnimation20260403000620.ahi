  <Controls ID="Screen">
    <OnStart>#include "stk.h"

/* Scroll animasyonunu ac */
LabelSet("L_Sayi", "ScrollEnable", "1");
LabelSet("L_Sayi", "ScrollSpeed", "6");

/* Baslangic degeri */
LabelSet("L_Sayi", "Text", "0");
</OnStart>
    <Functions>
    </Functions>
    <BgColor>-16777216</BgColor>
    <Name>Screen1</Name>
    <Rotate>Horizontal</Rotate>
    <Background_Image>
    </Background_Image>
    <BackgroundPictureHex />
  </Controls>
  <Controls ID="EVariable">
    <name>kat</name>
    <Left>59</Left>
    <Top>0</Top>
    <Data>0</Data>
    <Type>int</Type>
    <Locked>False</Locked>
    <Modifiers>Private</Modifiers>
  </Controls>
  <Controls ID="ETimer">
    <name>ETimerScroll</name>
    <Locked>False</Locked>
    <Left>3</Left>
    <Top>0</Top>
    <Interval>2000</Interval>
    <Enable>True</Enable>
    <event>#include "stk.h"
#include "stdio.h"


int kat;
int yon;
VarGet("kat", &amp;kat);
VarGet("yon", &amp;yon);

if( yon == 0 )
{
    kat++;
    if( kat &gt;= 10 ) yon = 1;
}
else
{
    kat--;
    if( kat &lt;= -2 ) yon = 0;
}

VarSet("kat", &amp;kat);
VarSet("yon", &amp;yon);

char buf[10];
sprintf(buf, "%d", kat);
LabelSet("L_Sayi", "Text", buf);
</event>
    <Modifiers>Private</Modifiers>
  </Controls>
