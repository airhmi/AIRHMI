  </Controls>
  <Controls ID="Screen">
    <OnStart>
    </OnStart>
    <Functions>
    </Functions>
    <BgColor>-16777216</BgColor>
    <Name>Screen1</Name>
    <Rotate>Horizontal</Rotate>
    <Background_Image>Varlık 42.png</Background_Image>
    <BackgroundPictureHex />
  </Controls>
  <Controls ID="EVariable">
    <name>onoff</name>
    <Left>227</Left>
    <Top>0</Top>
    <Data>0</Data>
    <Type>int</Type>
    <Locked>False</Locked>
    <Modifiers>Private</Modifiers>
  </Controls>
  <Controls ID="ETimer">
    <name>ETimer2</name>
    <Locked>False</Locked>
    <Left>171</Left>
    <Top>0</Top>
    <Interval>5000</Interval>
    <Enable>False</Enable>
    <event>#include "stk.h"
#include "stdio.h"
int onoff;
LocalIntVarGet("onoff", &amp;onoff);

if(onoff == 0) 
{
    LocalIntVarSet("onoff" ,1 );
}
else
{
 LabelSet("uart_label", "Visible", "0");
 TimerSet("ETimer2", "Enable", "0");
 LocalIntVarSet("onoff" ,0 );
}</event>
    <Modifiers>Private</Modifiers>
  </Controls>
  <Controls ID="EVariable">
    <name>toggle</name>
    <Left>115</Left>
    <Top>0</Top>
    <Data>0</Data>
    <Type>int</Type>
    <Locked>False</Locked>
    <Modifiers>Private</Modifiers>
  </Controls>
  <Controls ID="EVariable">
    <name>i</name>
    <Left>59</Left>
    <Top>0</Top>
    <Data>1</Data>
    <Type>int</Type>
    <Locked>False</Locked>
    <Modifiers>Private</Modifiers>
  </Controls>
  <Controls ID="ETimer">
    <name>ETimer1</name>
    <Locked>False</Locked>
    <Left>3</Left>
    <Top>0</Top>
    <Interval>200</Interval>
    <Enable>True</Enable>
    <event>#include "stk.h"
#include "stdio.h"
#include "string.h"
#include "stdlib.h"
int i, toggle;

LocalIntVarGet("i" ,&amp;i );

LocalIntVarGet("toggle" ,&amp;toggle );

if(toggle) printf("AIN%d", i);
else printf("DIN%d", i);



i++;
LocalIntVarSet("i" ,i);

if(i== 5) 
{
    toggle = (~toggle);
    LocalIntVarSet( "toggle", toggle ); 
    LocalIntVarSet("i" ,1);
}

char data[3000];
int len;
char buffer[200];
float adc;
char adc_val[10];

uartDataGet( data , &amp;len );


if( len &gt; 1 )
{
    LabelSet("uart_label", "Visible", "1");
    LabelSet("uart_label", "Caption", data);
    TimerSet("ETimer2", "Enable", "1");
    
  
    
    if(data[0] == 'A' )
    {
        memset(buffer, 0x00, sizeof(buffer));
        sprintf(buffer, "Label_ai%c", data[3]);
        
        char *key, *value, *val;

        key   = strtok(data, ":");
        value = strtok(NULL, ":");
        
        adc = atof(value);
        memset(adc_val, 0x00, sizeof(adc_val));
        sprintf(adc_val, "%.01f", adc);

        LabelSet(buffer, "Caption", adc_val);
    } 
    
    else if (data[0] == 'D' )
    {
        memset(buffer, 0x00, sizeof(buffer));
        sprintf(buffer, "Label_di%c", data[3]);
        
        if(data[5] == '0')
        {
            LabelSet(buffer, "Caption", "Kapali");
            LabelSet(buffer, "Font_Color", "#FF0000");
        }
        else
        {
            LabelSet(buffer, "Caption", "Acik");
            LabelSet(buffer, "Font_Color", "#32CD32");
        }
    }
    
}</event>
    <Modifiers>Private</Modifiers>
  </Controls>
