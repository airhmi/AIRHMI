    <name>ETimer2</name>
    <Locked>False</Locked>
    <Left>115</Left>
    <Top>0</Top>
    <Interval>1000</Interval>
    <Enable>True</Enable>
    <event>#include "stk.h"

int s = Video_StatusGet();

if( s )
{
    LabelSets("ELabel2" , "Playing...");
}
else
{
    LabelSets("ELabel2" , "");
}

</event>
