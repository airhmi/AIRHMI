  <Controls ID="ETimer">
    <name>tmr1</name>
    <Locked>False</Locked>
    <Left>59</Left>
    <Top>0</Top>
    <Interval>1000</Interval>
    <Enable>False</Enable>
    <event>
int i;
VarGet("count", &amp;i);
char data[20];
sprintf(data,"%d",i);
LabelSet("lCounter" , "Text", data);
i++;
VarSeti("count" , i);
</event>
    <Modifiers>Private</Modifiers>
  </Controls>
  <Controls ID="EVariable">
    <name>count</name>
    <Left>3</Left>
    <Top>0</Top>
    <Data>0</Data>
    <Type>int</Type>
    <Locked>False</Locked>
    <Modifiers>Private</Modifiers>
  </Controls>
